# ---------------------------------------------------------------------------
# Arogya environment template
# Copy to `.env.local` and fill in your own values. `.env*` is git-ignored
# (this example file is the only exception), so real values never get committed.
#
# IMPORTANT: every VITE_ variable is compiled into the browser bundle and is
# public. Only the OAuth *client ID* belongs here. Never put a client secret,
# refresh token or service-account key in a VITE_ variable.
# ---------------------------------------------------------------------------

# Google Drive report export (optional).
# Create a "Web application" OAuth client in the Google Cloud Console and paste
# only its client ID. See the in-app "Google Drive setup required." steps.
VITE_GOOGLE_OAUTH_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"

# Optional. A Drive folder that THIS app created (scope is drive.file, so the
# app cannot see arbitrary folders). Leave empty to export into My Drive root.
VITE_GOOGLE_DRIVE_EXPORT_FOLDER_ID=""

# Used by the Gemini-backed features of the surrounding project.
# Keep it server-side where possible; do not expose it in client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public origin of the running app.
APP_URL="http://localhost:3000"

# NASA Open APIs (optional). Used ONLY by the backend routes
# (/api/nasa/earth and /api/nasa/datasets) to fetch the latest EPIC Earth
# image and search data.nasa.gov. It is never compiled into the browser
# bundle. Locally, `vite dev`/`vite preview` read it from this file; on Vercel,
# add NASA_API_KEY in Project Settings > Environment Variables.
# Falls back to NASA's rate-limited DEMO_KEY if unset.
NASA_API_KEY="YOUR_NASA_API_KEY"
